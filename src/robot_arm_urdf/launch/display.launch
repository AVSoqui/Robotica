<launch>
  <!-- Cargar URDF -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find robot_arm_urdf)/urdf/robot_arm_urdf.urdf'" />

  <!-- Publicador de estado del robot -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <!-- Publicador de estados de las articulaciones -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />

  <!-- Lanzar RViz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robot_arm_urdf)/launch/robot.rviz" required="true" />
</launch>

