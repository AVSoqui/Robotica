<?xml version="1.0" encoding="utf-8"?>
<robot
  name="robot_arm_urdf">
  <link name="world"/>
<joint name="base_joint" type="fixed">
  <parent link="world"/>
  <child link="base_link"/>
  <origin rpy="0 0 0" xyz="0.0 0.0 0.17"/>
</joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.031662 -1.6593E-05 0.093316"
        rpy="0 0 0" />
      <mass
        value="20.485" />
      <inertia
        ixx="0.34723"
        ixy="7.3552E-05"
        ixz="-0.042273"
        iyy="0.43484"
        iyz="6.6575E-05"
        izz="0.51047" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/base_link.dae" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 0.75294 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/base_link.dae" />
      </geometry>
    </collision>
  </link>
  <link
    name="link_1">
    <inertial>
      <origin
        xyz="-1.5626E-10 -0.12292 2.8851E-17"
        rpy="0 0 0" />
      <mass
        value="14.805" />
      <inertia
        ixx="0.28701"
        ixy="-1.2939E-09"
        ixz="1.283E-09"
        iyy="0.11168"
        iyz="-7.7555E-18"
        izz="0.31422" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_1.dae" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.16078 0.16863 0.45098 0.4" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_1.dae" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint_1"
    type="revolute">
    <origin
      xyz="0 0 0.496"
      rpy="1.5708 0 0" />
    <parent
      link="base_link" />
    <child
      link="link_1" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="96.8"
      velocity="3" />
  </joint>
  <link
    name="link_2">
    <inertial>
      <origin
        xyz="-0.18788 1.414E-05 -0.0021187"
        rpy="0 0 0" />
      <mass
        value="14.929" />
      <inertia
        ixx="0.15396"
        ixy="8.6361E-06"
        ixz="-0.0012193"
        iyy="0.7156"
        iyz="-2.6881E-05"
        izz="0.62367" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_2.dae" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 0.9" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_2.dae" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint_2"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="0 0 -1.5708" />
    <parent
      link="link_1" />
    <child
      link="link_2" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-1.57"
      upper="1.57"
      effort="90"
      velocity="3.5" />
  </joint>
  <link
    name="link_3">
    <inertial>
      <origin
        xyz="0.12117 -0.13618 0.01"
        rpy="0 0 0" />
      <mass
        value="12.293" />
      <inertia
        ixx="0.34515"
        ixy="0.040693"
        ixz="-2.1478E-17"
        iyy="0.076693"
        iyz="1.7774E-16"
        izz="0.37813" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_3.dae" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.0078431 0.23922 0.82353 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_3.dae" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint_3"
    type="revolute">
    <origin
      xyz="-0.5 0 0"
      rpy="0 0 3.1416" />
    <parent
      link="link_2" />
    <child
      link="link_3" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-0.7854"
      upper="2.3562"
      effort="44.8"
      velocity="4" />
  </joint>
  <link
    name="link_4">
    <inertial>
      <origin
        xyz="7.1522E-05 0.04925 6.1596E-08"
        rpy="0 0 0" />
      <mass
        value="2.2635" />
      <inertia
        ixx="0.019962"
        ixy="-2.3083E-05"
        ixz="-3.7933E-09"
        iyy="0.0040787"
        iyz="6.4088E-09"
        izz="0.020598" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_4.dae" />
      </geometry>
      <material
        name="PLA">
        <color
          rgba="0.0078431 0.23922 0.82353 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_urdf/meshes/link_4.dae" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint_4"
    type="revolute">
    <origin
      xyz="0.145 -0.42746 0.01"
      rpy="0 0 0" />
    <parent
      link="link_3" />
    <child
      link="link_4" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-1.57"
      upper="1.57"
      effort="17.6"
      velocity="5" />
  </joint>

    <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

  <!-- Transmisiones -->
  <transmission name="trans_joint_1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_joint_1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="trans_joint_2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_joint_2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="trans_joint_3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_joint_3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="trans_joint_4">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_joint_4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Self Collision -->
  <gazebo reference="link_1"><selfCollide>true</selfCollide></gazebo>
  <gazebo reference="link_2"><selfCollide>true</selfCollide></gazebo>
  <gazebo reference="link_3"><selfCollide>true</selfCollide></gazebo>
  <gazebo reference="link_4"><selfCollide>true</selfCollide></gazebo>

</robot>

